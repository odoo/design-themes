#. module: theme_kea
#: model_terms:theme.ir.ui.view,arch:theme_kea.s_features
msgid "<b>360-degree vision</b>"
msgstr "<b>360-stopinjski pogled</b>"

#. module: theme_kea
#: model_terms:theme.ir.ui.view,arch:theme_kea.s_features
msgid "<b>Built in mic</b>"
msgstr "<b>Vgrajen mikrofon</b>"

#. module: theme_kea
#: model_terms:theme.ir.ui.view,arch:theme_kea.s_features
msgid "<b>Stunning visuals</b>"
msgstr "<b>Osupljive vizualne podobe</b>"

#. module: theme_kea
#: model_terms:theme.ir.ui.view,arch:theme_kea.s_image_text
msgid ""
"<font style=\"background-image: linear-gradient(135deg, var(--o-color-1) 0%,"
" var(--o-color-2) 100%);\" class=\"text-gradient\">Enter in a new "
"world</font>"
msgstr ""
"<font style=\"background-image: linear-gradient(135deg, var(--o-color-1) 0%, "
"var(--o-color-2) 100%);\" class=\"text-gradient\">Vstopite v nov svet</font>"

#. module: theme_kea
#: model_terms:theme.ir.ui.view,arch:theme_kea.s_text_image
msgid ""
"<font style=\"background-image: linear-gradient(135deg, var(--o-color-1) 0%,"
" var(--o-color-2) 100%);\" class=\"text-gradient\">Full immersion</font>"
msgstr ""
"<font style=\"background-image: linear-gradient(135deg, var(--o-color-1) 0%, "
"var(--o-color-2) 100%);\" class=\"text-gradient\">Popolna potopitev</font>"

#. module: theme_kea
#: model_terms:theme.ir.ui.view,arch:theme_kea.s_features
msgid "A small explanation of this great feature, in clear words."
msgstr "Kratka razlaga te odlične funkcije z jasnimi besedami."

#. module: theme_kea
#: model_terms:theme.ir.ui.view,arch:theme_kea.s_media_list
msgid "Comfort &amp; Ease"
msgstr "Udobje &amp; Lahkotnost"

#. module: theme_kea
#: model_terms:theme.ir.ui.view,arch:theme_kea.s_color_blocks_2
msgid ""
"Conquer leaderboards, crush workouts, create with friends and more. Get lost"
" in a growing library of VR classics and all-new experiences."
msgstr ""
"Osvojite lestvice najboljših, obvladajte vadbe, ustvarjajte s prijatelji in "
"še več. Izgubite se v rastoči knjižnici klasičnih vsebin VR in povsem novih "
"doživetij."

#. module: theme_kea
#: model_terms:theme.ir.ui.view,arch:theme_kea.s_three_columns
msgid "Design"
msgstr "Načrtovanje"

#. module: theme_kea
#: model_terms:theme.ir.ui.view,arch:theme_kea.s_numbers
msgid "Different lenses"
msgstr "Različne leče"

#. module: theme_kea
#: model_terms:theme.ir.ui.view,arch:theme_kea.s_cover
msgid "Discover more"
msgstr "Odkrijte več"

#. module: theme_kea
#: model_terms:theme.ir.ui.view,arch:theme_kea.s_picture
msgid "Experience a new world"
msgstr "Doživite nov svet"

#. module: theme_kea
#: model_terms:theme.ir.ui.view,arch:theme_kea.s_media_list
msgid "Fitting design"
msgstr "Ustrezna zasnova"

#. module: theme_kea
#: model_terms:theme.ir.ui.view,arch:theme_kea.s_color_blocks_2
msgid "Freedom"
msgstr "Svoboda"

#. module: theme_kea
#: model_terms:theme.ir.ui.view,arch:theme_kea.s_three_columns
msgid ""
"From design concept to the showroom, create and manage workflows with better"
" collaboration."
msgstr ""
"Od zasnove do razstavnega salona ustvarjajte in upravljajte delovne tokove z "
"boljšim sodelovanjem."

#. module: theme_kea
#: model_terms:theme.ir.ui.view,arch:theme_kea.s_three_columns
msgid ""
"From high-risk safety simulations and maintenance procedures to soft skills "
"like public speaking."
msgstr ""
"Od varnostnih simulacij z visokim tveganjem in vzdrževalnih postopkov do "
"mehkih veščin, kot je javno nastopanje."

#. module: theme_kea
#: model_terms:theme.ir.ui.view,arch:theme_kea.s_three_columns
msgid "Gaming"
msgstr "Igralništvo"

#. module: theme_kea
#: model_terms:theme.ir.ui.view,arch:theme_kea.s_color_blocks_2
msgid "Multiplayer"
msgstr "Več igralcev"

#. module: theme_kea
#: model_terms:theme.ir.ui.view,arch:theme_kea.s_media_list
msgid "Natural control"
msgstr "Naravni nadzor"

#. module: theme_kea
#: model_terms:theme.ir.ui.view,arch:theme_kea.s_numbers
msgid "New games every week"
msgstr ""

#. module: theme_kea
#: model_terms:theme.ir.ui.view,arch:theme_kea.s_color_blocks_2
msgid ""
"No matter who you are, with a growing library of games and experiences there"
" is no limit to where you can go and what you can do in virtual reality."
msgstr ""
"Ne glede na to, kdo ste, z rastočo knjižnico iger in doživetij v navidezni "
"resničnosti ni omejitev glede tega, kam lahko greste in kaj lahko počnete."

#. module: theme_kea
#: model_terms:theme.ir.ui.view,arch:theme_kea.s_numbers
msgid "Number of controllers"
msgstr "Število krmilnikov"

#. module: theme_kea
#: model_terms:theme.ir.ui.view,arch:theme_kea.s_picture
msgid ""
"Put yourself at the center of an extraordinary gaming universe with "
"exclusive games."
msgstr ""
"Postavite se v središče izjemnega igralnega vesolja z ekskluzivnimi igrami."

#. module: theme_kea
#: model_terms:theme.ir.ui.view,arch:theme_kea.s_numbers
msgid "Storage capacity (GB)"
msgstr "Zmogljivost shranjevanja (GB)"

#. module: theme_kea
#: model_terms:theme.ir.ui.view,arch:theme_kea.s_features
msgid "Tell what's the value for the customer for this feature."
msgstr "Povejte, kakšna je vrednost te funkcije za stranko."

#. module: theme_kea
#: model_terms:theme.ir.ui.view,arch:theme_kea.s_cover
msgid "The Revolution <br/> in Virtual Reality"
msgstr "Revolucija <br/> v virtualni resničnosti"

#. module: theme_kea
#: model:ir.model,name:theme_kea.model_theme_utils
msgid "Theme Utils"
msgstr "Pomožni pripomočki teme"

#. module: theme_kea
#: model_terms:theme.ir.ui.view,arch:theme_kea.s_three_columns
msgid "Training"
msgstr "Šolanje"

#. module: theme_kea
#: model_terms:theme.ir.ui.view,arch:theme_kea.s_media_list
msgid ""
"Use this snippet to build various types of components that feature a left- "
"or right-aligned image alongside textual content. Duplicate the element to "
"create a list that fits your needs."
msgstr ""
"Ta gradnik uporabite za izdelavo različnih vrst komponent, ki vsebujejo levo "
"ali desno poravnano sliko poleg besedilne vsebine. Element podvojite in "
"ustvarite seznam, ki ustreza vašim potrebam."

#. module: theme_kea
#: model_terms:theme.ir.ui.view,arch:theme_kea.s_three_columns
msgid ""
"VR takes immersive gaming to another level. From deep environmental "
"interactions to puzzle solving."
msgstr ""
"VR popelje poglobljeno igranje na povsem novo raven. Od poglobljenih "
"interakcij z okoljem do reševanja ugank."

#. module: theme_kea
#: model_terms:theme.ir.ui.view,arch:theme_kea.s_picture
msgid ""
"Watch as a living game world comes alive all around you, with a seamless "
"field of view wherever you look."
msgstr ""
"Opazujte, kako povsod okoli vas oživi živi svet igre, z neprekinjenim vidnim "
"poljem, kamor koli pogledate."

#. module: theme_kea
#: model_terms:theme.ir.ui.view,arch:theme_kea.s_media_list
msgid ""
"We only use original parts or parts of equivalent quality. ​We make sure you"
" get the best quality available on the market at the best price. All our "
"interventions are guaranteed for a period of one year."
msgstr ""
"Uporabljamo samo originalne dele ali dele enakovredne kakovosti. ​Poskrbimo, "
"da dobite najboljšo kakovost, ki je na voljo na trgu, po najboljši ceni. Vsa "
"naša popravila so zajamčena za obdobje enega leta."

#. module: theme_kea
#: model_terms:theme.ir.ui.view,arch:theme_kea.s_text_image
msgid ""
"Write one or two paragraphs describing your product or services. To be "
"successful your content needs to be useful to your readers."
msgstr ""
"V enem ali dveh odstavkih opišite svoj izdelek ali storitev. Če želite biti "
"uspešni, mora biti vsebina uporabna za vaše bralce."

#. module: theme_kea
#: model_terms:theme.ir.ui.view,arch:theme_kea.s_features
msgid "Write what the customer would like to know, not what you want to show."
msgstr ""
"Napišite, kaj bi stranka želela izvedeti, ne tega, kar želite prikazati."
