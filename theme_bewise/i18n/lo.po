#. module: theme_bewise
#: model_terms:theme.ir.ui.view,arch:theme_bewise.s_masonry_block_default_template
msgid ""
"<a href=\"#\" class=\"o_translate_inline btn btn-primary\">Learn More</a>"
msgstr ""
"<a href=\"#\" class=\"o_translate_inline btn btn-primary\">ຮຽນຮູ້ເພີ່ມຕື່ມ</a>"

#. module: theme_bewise
#: model_terms:theme.ir.ui.view,arch:theme_bewise.s_color_blocks_2
msgid ""
"<br/>\n"
"        Are you searching for a school where cutting-edge programmes are "
"taught, in a continually evolving environment and located in the heart of a "
"dynamic city? You have just found it!\n"
"        <br/>\n"
"        <br/>"
msgstr ""
"<br/>\n"
"        ທ່ານກຳລັງຊອກຫາໂຮງຮຽນທີ່ມີການຮຽນ-ການສອນຫຼັກສູດທີ່ທັນສະໄໝ, ຢູ່ໃນສະພາບແວດລ້ອມທີ່ມີການພັດທະ"
"ນາຢ່າງຕໍ່ເນື່ອງ ແລະ ຕັ້ງຢູ່ໃຈກາງຕົວເມືອງທີ່ຄຶກຄັກມີຊີວິດຊີວາຢູ່ບໍ? ທ່ານໄດ້ພົບມັນແລ້ວ!\n"
"        <br/>\n"
"        <br/>"

#. module: theme_bewise
#: model_terms:theme.ir.ui.view,arch:theme_bewise.s_color_blocks_2
msgid ""
"<br/>\n"
"        The small and modern campus is only a 10-minute walk away from the "
"city centre and is easily accessible by car and public transport. It is also "
"close to the train stations.\n"
"        <br/>\n"
"        <br/>"
msgstr ""
"<br/>\n"
"        ວິທະຍາເຂດຂະໜາດກະທັດຮັດ ແລະ ທັນສະໄໝນີ້ ແມ່ນຍ່າງພຽງແຕ່ 10 ນາທີຈາກໃຈກາງຕົວເມືອງ ແລະ "
"ສາມາດເດີນທາງໄປມາໄດ້ຢ່າງສະດວກສະບາຍດ້ວຍລົດສ່ວນຕົວ ແລະ ການຂົນສົ່ງສາທາລະນະ. ນອກຈາກນີ້ ຍັງຢູ່ໃກ້ກັບ"
"ສະຖານີລົດໄຟອີກດ້ວຍ.\n"
"        <br/>\n"
"        <br/>"

