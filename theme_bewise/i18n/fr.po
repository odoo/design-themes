msgid "University, Education, Schools, Young, Play, Kids"
msgstr ""

msgid ""
"\" A leading institution for growth. <br/>Supportive, forward-thinking, and "
"academically rigorous. \""
msgstr ""
"\" Une institution de premier plan pour progresser. <br/>Un soutien, une "
"vision d'avenir et une rigueur académique. \""

msgid ""
"\" Outstanding education and support! <br/>They consistently exceed my "
"expectations. \""
msgstr ""
"\" Une formation et un soutien exceptionnels ! <br/>Ils dépassent "
"systématiquement mes attentes. \""

msgid ""
"\" Their programs transformed my career. Innovative, challenging, and "
"inspiring. \""
msgstr ""
"\" Leurs programmes ont transformé ma carrière. Ils sont innovants, "
"stimulants et inspirants. \""

msgid "$15.00 per kit"
msgstr "15.00 € par ensemble"

msgid "$150.00 each"
msgstr "150.00 € pièce"

msgid "$20.00 each"
msgstr "20.00 € pièce"

