#. module: theme_bewise
#: model_terms:theme.ir.ui.view,arch:theme_bewise.s_call_to_action
msgid "3,000 students graduate each year and find a job within 2 months"
msgstr ""
"3 000 студенти се дипломират всяка година и намират работа в рамките на 2 "
"месеца"

#. module: theme_bewise
#: model_terms:theme.ir.ui.view,arch:theme_bewise.s_company_team
