#. module: theme_kiddo
#: model_terms:theme.ir.ui.view,arch:theme_kiddo.s_call_to_action
msgid "2,000 parents<br/> brought their kid to our nursery."
msgstr "2.000 staršev<br/> je pripeljalo svojega otroka v naš vrtec."

#. module: theme_kiddo
#: model_terms:theme.ir.ui.view,arch:theme_kiddo.s_banner
msgid "A little place <br/>of paradise"
msgstr "Majhen kotiček <br/>raja"

#. module: theme_kiddo
#: model_terms:theme.ir.ui.view,arch:theme_kiddo.s_product_list
msgid "About us"
msgstr "O nas"

#. module: theme_kiddo
#: model_terms:theme.ir.ui.view,arch:theme_kiddo.s_image_text
msgid "Activities"
msgstr "Aktivnosti"

#. module: theme_kiddo
#: model_terms:theme.ir.ui.view,arch:theme_kiddo.s_three_columns
msgid ""
"All activities are planned to meet each child’s individual needs. This "
"approach will help your child to develop to the best of their ability."
msgstr ""
"Vse aktivnosti so načrtovane tako, da zadovoljijo individualne potrebe "
"vsakega otroka. Ta pristop bo vašemu otroku pomagal, da se razvije po svojih "
"najboljših zmožnostih."

#. module: theme_kiddo
#: model_terms:theme.ir.ui.view,arch:theme_kiddo.s_call_to_action
msgid "Contact us"
msgstr "Kontakt"

#. module: theme_kiddo
#: model_terms:theme.ir.ui.view,arch:theme_kiddo.s_call_to_action
msgid "Entrust us with your children and go to work with peace of mind"
msgstr "Zaupajte nam svoje otroke in odidite na delo brez skrbi"

#. module: theme_kiddo
#: model_terms:theme.ir.ui.view,arch:theme_kiddo.s_product_list
msgid "Events"
msgstr "Dogodki"

#. module: theme_kiddo
#: model_terms:theme.ir.ui.view,arch:theme_kiddo.s_three_columns
msgid "For every kid"
msgstr ""

#. module: theme_kiddo
#: model_terms:theme.ir.ui.view,arch:theme_kiddo.s_cover
msgid "Kiddo Nursery"
msgstr "Vrtec Kiddo"

#. module: theme_kiddo
#: model_terms:theme.ir.ui.view,arch:theme_kiddo.s_picture
msgid "Letting each child explore and grow at their own pace"
msgstr "Omogočanje, da vsak otrok raziskuje in raste v svojem tempu"

#. module: theme_kiddo
#: model_terms:theme.ir.ui.view,arch:theme_kiddo.s_three_columns
msgid "Open-door policy"
msgstr ""

#. module: theme_kiddo
#: model_terms:theme.ir.ui.view,arch:theme_kiddo.s_three_columns
msgid ""
"Our aim is to make the early years of your child’s life as enjoyable, "
"rewarding and positive as possible."
msgstr ""
"Naš cilj je, da so zgodnja leta življenja vašega otroka čim bolj prijetna, "
"izpolnjujoča in pozitivna."

#. module: theme_kiddo
#: model_terms:theme.ir.ui.view,arch:theme_kiddo.s_three_columns
msgid "Our mission"
msgstr "Naše poslanstvo"

#. module: theme_kiddo
#: model_terms:theme.ir.ui.view,arch:theme_kiddo.s_picture
msgid ""
"Our qualified staff ensure that each childs' needs are always recognised and"
" fulfilled."
msgstr ""
"Naše usposobljeno osebje poskrbi, da so potrebe vsakega otroka vedno "
"prepoznane in izpolnjene."

#. module: theme_kiddo
#: model_terms:theme.ir.ui.view,arch:theme_kiddo.s_product_list
msgid "Our team"
msgstr "Naša ekipa"

#. module: theme_kiddo
#: model_terms:theme.ir.ui.view,arch:theme_kiddo.s_image_text
msgid "Our team is composed of experienced nursery nurses."
msgstr "Našo ekipo sestavljajo izkušene vzgojiteljice."

#. module: theme_kiddo
#: model_terms:theme.ir.ui.view,arch:theme_kiddo.s_product_list
msgid "Playground"
msgstr "Igrišče"

#. module: theme_kiddo
#: model_terms:theme.ir.ui.view,arch:theme_kiddo.s_cover
msgid ""
"The countryside nursery since 2002.<br/>\n"
"        A truly unique service in a highly secure and tranquil setting."
msgstr ""
"Podeželski vrtec od leta 2002.<br/>\n"
"        Resnično edinstvena storitev v zelo varnem in mirnem okolju."

#. module: theme_kiddo
#: model:ir.model,name:theme_kiddo.model_theme_utils
msgid "Theme Utils"
msgstr "Pomožni pripomočki teme"

#. module: theme_kiddo
#: model_terms:theme.ir.ui.view,arch:theme_kiddo.s_image_text
msgid ""
"They will propose to your children educational activities, playful, varied "
"and adapted to the stage of development."
msgstr ""
"Vašim otrokom bodo predlagali izobraževalne, igrive in raznolike dejavnosti, "
"prilagojene njihovi razvojni stopnji."

#. module: theme_kiddo
#: model_terms:theme.ir.ui.view,arch:theme_kiddo.s_banner
msgid ""
"This is a simple hero unit, a simple jumbotron-style component for calling "
"extra attention to featured content or information."
msgstr ""
"To je preprosta enota junaka, preprosta komponenta v slogu jumbotrona, ki "
"opozarja na predstavljeno vsebino ali informacije."

#. module: theme_kiddo
#: model_terms:theme.ir.ui.view,arch:theme_kiddo.s_picture
msgid ""
"Through stimulating and fun activities, our aim<br/>\n"
"        is to promote all areas of a childs' development."
msgstr ""
"S spodbudnimi in zabavnimi dejavnostmi je naš cilj<br/>\n"
"        spodbujati vsa področja otrokovega razvoja."

#. module: theme_kiddo
#: model_terms:theme.ir.ui.view,arch:theme_kiddo.s_product_list
msgid "Visit us"
msgstr "Obiščite nas"

#. module: theme_kiddo
#: model_terms:theme.ir.ui.view,arch:theme_kiddo.s_three_columns
msgid ""
"You are welcome to come and see the nursery and meet the team at any time "
"convenient to you."
msgstr ""
"Vabljeni ste, da pridete in si ogledate vrtec ter spoznate ekipo, kadar koli "
"vam ustreza."

#. module: theme_kiddo
#. odoo-javascript
#: code:addons/theme_kiddo/static/src/js/tour.js:0
#, python-format
msgid "width"
msgstr "Širina"
