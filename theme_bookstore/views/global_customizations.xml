<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ======== CAROUSEL INTRO ======== -->
    <template id="s_carousel_intro" inherit_id="website.s_carousel_intro">
        <xpath expr="//div[hasclass('s_carousel_intro')]" position="attributes">
            <attribute name="class" add="s_carousel_boxed s_carousel_rounded o_cc o_cc2" remove="s_carousel_default" separator=" "/>
        </xpath>
        <!-- All slides -->
        <xpath expr="//div[hasclass('s_carousel_intro_item')][1]" position="attributes">
            <attribute name="class" add="pt56" remove="o_cc o_cc1 pt72" separator=" "/>
        </xpath>
        <xpath expr="//div[hasclass('s_carousel_intro_item')][2]" position="attributes">
            <attribute name="class" add="pt56" remove="o_cc o_cc1 pt72" separator=" "/>
        </xpath>
        <xpath expr="//div[hasclass('s_carousel_intro_item')][3]" position="attributes">
            <attribute name="class" add="pt56" remove="o_cc o_cc1 pt72" separator=" "/>
        </xpath>
        <xpath expr="//div[hasclass('s_carousel_intro_item')][1]//div[hasclass('o_grid_mode')]" position="attributes">
            <attribute name="data-row-count">10</attribute>
        </xpath>
        <xpath expr="//div[hasclass('s_carousel_intro_item')][2]//div[hasclass('o_grid_mode')]" position="attributes">
            <attribute name="data-row-count">10</attribute>
        </xpath>
        <xpath expr="//div[hasclass('s_carousel_intro_item')][3]//div[hasclass('o_grid_mode')]" position="attributes">
            <attribute name="data-row-count">10</attribute>
        </xpath>
        <!-- Slide 1 -->
        <xpath expr="//div[hasclass('s_carousel_intro_item')][1]//div[hasclass('o_grid_item')][1]" position="attributes">
            <attribute name="class" add="g-col-lg-6 col-lg-6 g-height-10 o_cc o_cc3 rounded" remove="g-height-8 g-col-lg-5 col-lg-5" separator=" "/>
            <attribute name="style">z-index: 1; grid-area: 1 / 1 / 11 / 7; --grid-item-padding-x: 45px; --grid-item-padding-y: 55px; --box-border-top-right-radius: 0px; --box-border-bottom-right-radius: 0px;</attribute>
        </xpath>
        <xpath expr="//div[hasclass('s_carousel_intro_item')][1]//div[hasclass('o_grid_item')][1]" position="replace" mode="inner">
            <h1 class="display-4-fs"><font class="text-o-color-1">Gideon Schwartz Collection</font></h1>
            <p class="small"><br/></p>
            <p class="lead">Use this snippet to presents your content in a slideshow-like format.</p>
            <p class="small"><br/></p>
            <p><a href="#top" class="o_translate_inline btn btn-primary btn-lg">Shop now</a></p>
        </xpath>
        <xpath expr="//div[hasclass('s_carousel_intro_item')][1]//div[hasclass('o_grid_item_image')]" position="attributes">
            <attribute name="class" add="g-height-10 rounded" remove="g-height-4" separator=" "/>
            <attribute name="style">z-index: 3; grid-area: 1 / 7 / 11 / 13; --grid-item-padding-x: 0px; --grid-item-padding-y: 0px; --box-border-top-left-radius: 0px; --box-border-bottom-left-radius: 0px;</attribute>
        </xpath>
        <xpath expr="//div[hasclass('s_carousel_intro_item')][1]//div[hasclass('o_grid_item')][2]" position="replace"/>
        <!-- Slide 2 -->
        <xpath expr="//div[hasclass('s_carousel_intro_item')][2]//div[hasclass('o_grid_item')][1]" position="attributes">
            <attribute name="class" add="g-height-10 o_cc o_cc3 rounded" remove="g-height-5" separator=" "/>
            <attribute name="style">z-index: 1; grid-area: 1 / 1 / 11 / 7; --grid-item-padding-x: 45px; --grid-item-padding-y: 55px; --box-border-top-right-radius: 0px; --box-border-bottom-right-radius: 0px;</attribute>
        </xpath>
        <xpath expr="//div[hasclass('s_carousel_intro_item')][2]//div[hasclass('o_grid_item')][1]" position="replace" mode="inner">
            <h2 class="display-4-fs"><font class="text-o-color-1">Books You Can't Miss</font></h2>
            <p class="small"><br/></p>
            <p class="lead">Discover our most popular books, loved by readers everywhere. Find your next great read among our top bestsellers.</p>
            <p class="small"><br/></p>
            <p><a href="#" class="o_translate_inline btn btn-primary btn-lg">Browse Bestsellers</a></p>
        </xpath>
        <xpath expr="//div[hasclass('s_carousel_intro_item')][2]//div[hasclass('o_grid_item_image')]" position="attributes">
            <attribute name="class" add="g-col-lg-6 col-lg-6 g-height-10 rounded" remove="g-height-7 g-col-lg-5 col-lg-5" separator=" "/>
            <attribute name="style">z-index: 3; grid-area: 1 / 7 / 11 / 13; --grid-item-padding-x: 0px; --grid-item-padding-y: 0px; --box-border-top-left-radius: 0px; --box-border-bottom-left-radius: 0px;</attribute>
        </xpath>
        <xpath expr="//div[hasclass('s_carousel_intro_item')][2]//div[hasclass('o_grid_item')][2]" position="replace"/>
        <!-- Slide 3 -->
        <xpath expr="//div[hasclass('s_carousel_intro_item')][3]//div[hasclass('o_grid_item')][1]" position="attributes">
            <attribute name="class" add="g-col-lg-6 col-lg-6 g-height-10 o_cc o_cc3 rounded" remove="g-height-8 g-col-lg-5 col-lg-5" separator=" "/>
            <attribute name="style">z-index: 1; grid-area: 1 / 1 / 11 / 7; --grid-item-padding-x: 45px; --grid-item-padding-y: 55px; --box-border-top-right-radius: 0px; --box-border-bottom-right-radius: 0px;</attribute>
        </xpath>
        <xpath expr="//div[hasclass('s_carousel_intro_item')][3]//div[hasclass('o_grid_item')][1]" position="replace" mode="inner">
            <h2 class="display-4-fs"><font class="text-o-color-1">Your Destination for Books and More</font></h2>
            <p class="small"><br/></p>
            <p class="lead"><span class="h6-fs">We offer a curated selection of books and literary resources to inspire readers and foster a love for reading in our vibrant community.</span></p>
            <p class="small"><br/></p>
            <p><a href="/contactus" class="o_translate_inline btn btn-primary btn-lg">Explore categories</a></p>
        </xpath>
        <xpath expr="//div[hasclass('s_carousel_intro_item')][3]//div[hasclass('o_grid_item_image')]" position="attributes">
            <attribute name="class" add="g-col-lg-6 col-lg-6 g-height-10 rounded" remove="g-height-8 g-col-lg-3 col-lg-3" separator=" "/>
            <attribute name="style">z-index: 3; grid-area: 1 / 7 / 11 / 13; --grid-item-padding-x: 0px; --grid-item-padding-y: 0px; --box-border-top-left-radius: 0px; --box-border-bottom-left-radius: 0px;</attribute>
        </xpath>
        <xpath expr="//div[hasclass('s_carousel_intro_item')][3]//div[hasclass('o_grid_item')][2]" position="replace"/>
        <!-- Controllers -->
        <xpath expr="//div[hasclass('o_horizontal_controllers_row')]" position="attributes">
            <attribute name="class" remove="flex-row-reverse" separator=" "/>
        </xpath>
    </template>

    <!-- ======== BENTO GRID ======== -->
    <template id="s_bento_grid" inherit_id="website.s_bento_grid">
        <!-- Grid container -->
        <xpath expr="//div[hasclass('o_grid_mode')]" position="attributes">
            <attribute name="data-row-count">11</attribute>
        </xpath>
        <!-- Card 1 -->
        <xpath expr="//div[hasclass('o_grid_item')][1]" position="attributes">
            <attribute name="class" add="g-col-lg-4 col-lg-4 o_bg_img_origin_border_box justify-content-center" remove="g-col-lg-6 col-lg-6 justify-content-start" separator=" "/>
            <attribute name="style" add="grid-area: 1 / 1 / 7 / 5;" separator=";" />
        </xpath>
        <xpath expr="//div[hasclass('o_grid_item')][1]//h2" position="attributes">
            <attribute name="style">text-align: center;</attribute>
        </xpath>
        <xpath expr="//div[hasclass('o_grid_item')][1]//p[hasclass('lead')]" position="replace">
            <p class="lead" style="text-align: center;"><span class="o_small-fs">Discover<strong class="text-o-color-1"> -&gt;</strong></span></p>
        </xpath>
        <!-- Card 2 -->
        <xpath expr="//div[hasclass('o_grid_item')][2]" position="replace" mode="inner">
            <div class="o_we_bg_filter bg-black-25" contenteditable="false"></div>
            <h2 class="h3-fs" style="text-align: center;"><br/>Kids' Books</h2>
            <p class="lead" style="text-align: center;"><span class="o_small-fs">Discover<strong class="text-o-color-1"> -&gt;</strong></span></p>
        </xpath>
        <xpath expr="//div[hasclass('o_grid_item')][2]" position="attributes">
            <attribute name="class" add="g-col-lg-8 col-lg-8 justify-content-center o_bg_img_origin_border_box" remove="g-col-lg-6 col-lg-6 justify-content-start" separator=" "/>
            <attribute name="style" add="grid-area: 1 / 5 / 6 / 13;" separator=";" />
        </xpath>
        <!-- Card 3 (CTA) -->
        <xpath expr="//div[hasclass('o_grid_item')][3]" position="attributes">
            <attribute name="class" add="o_cc4 justify-content-center" remove="o_cc5" separator=" " />
            <attribute name="style" add="grid-area: 7 / 1 / 12 / 5;" separator=";" />
        </xpath>
        <xpath expr="//div[hasclass('o_grid_item')][3]//h2" position="attributes">
            <attribute name="class" add="h4-fs" remove="h3-fs" separator=" "/>
            <attribute name="style">text-align: center;</attribute>
        </xpath>
        <xpath expr="//div[hasclass('o_grid_item')][3]//p[2]" position="attributes">
            <attribute name="style">text-align: center;</attribute>
        </xpath>
        <xpath expr="//div[hasclass('o_grid_item')][3]//a" position="attributes">
            <attribute name="class" add="btn-outline-secondary" remove="btn-secondary" separator=" "/>
        </xpath>
        <xpath expr="//div[hasclass('o_grid_item')][3]//p" position="replace"/>
        <!-- Card 4 -->
        <xpath expr="//div[hasclass('o_grid_item')][4]" position="attributes">
            <attribute name="class" add="o_bg_img_origin_border_box g-col-lg-4 g-height-6 col-lg-4 justify-content-center" remove="g-col-lg-6 g-height-10 col-lg-6 justify-content-start" separator=" "/>
            <attribute name="style" add="grid-area: 6 / 5 / 12 / 9;" separator=";" />
        </xpath>
        <xpath expr="//div[hasclass('o_grid_item')][4]//h2" position="before">
            <br/>
        </xpath>
        <xpath expr="//div[hasclass('o_grid_item')][4]//h2" position="attributes">
            <attribute name="style">text-align: center;</attribute>
        </xpath>
        <xpath expr="//div[hasclass('o_grid_item')][4]//p[hasclass('lead')]" position="replace">
            <p class="lead" style="text-align: center;"><span class="o_small-fs">Discover<strong class="text-o-color-1"> -&gt;</strong></span></p>
        </xpath>
        <!-- Card 5 -->
        <xpath expr="//div[hasclass('o_grid_item')][5]" position="attributes">
            <attribute name="class" add="o_bg_img_origin_border_box g-height-6 g-col-lg-4 col-lg-4 justify-content-center" remove="g-col-lg-6 g-height-14 col-lg-6 justify-content-start" separator=" "/>
            <attribute name="style" add="grid-area: 6 / 9 / 12 / 13;" separator=";" />
        </xpath>
        <xpath expr="//div[hasclass('o_grid_item')][5]//blockquote" position="replace"/>
        <xpath expr="//div[hasclass('o_grid_item')][5]//div[hasclass('o_we_bg_filter')]" position="after">
            <h2 class="h3-fs" style="text-align: center;"><br/>Classics</h2>
            <p class="lead" style="text-align: center;"><span class="o_small-fs">Discover<strong class="text-o-color-1"> -&gt;</strong></span></p>
        </xpath>
    </template>

    <!-- ======== CATEGORY AND PRODUCTS ======== -->
    <template id="s_category_and_products" inherit_id="website.s_category_and_products">
        <!-- Card 2 -->
        <xpath expr="//div[hasclass('col-lg-3')][2]//div[hasclass('s_card')]" position="attributes">
            <attribute name="class" add="bg-100" remove="o_cc1" separator=" "/>
        </xpath>
        <!-- Card 3 -->
        <xpath expr="//div[hasclass('col-lg-3')][3]//div[hasclass('s_card')]" position="attributes">
            <attribute name="class" add="bg-100" remove="o_cc1" separator=" "/>
        </xpath>
        <xpath expr="//div[hasclass('col-lg-3')][3]//p" position="replace" mode="inner">
            <strong>$ 35</strong>
        </xpath>
        <!-- Card 4 -->
        <xpath expr="//div[hasclass('col-lg-3')][4]//div[hasclass('s_card')]" position="attributes">
            <attribute name="class" add="bg-100" remove="o_cc1" separator=" "/>
        </xpath>
        <xpath expr="//div[hasclass('col-lg-3')][4]//p" position="replace" mode="inner">
            <strong>$ 18</strong>
        </xpath>
    </template>

    <!-- ======== ANNOUNCEMENT SCROLL ======== -->
    <template id="s_announcement_scroll" inherit_id="website.s_announcement_scroll">
        <xpath expr="//section" position="attributes">
            <attribute name="style">--marquee-animation-speed: 5s; --marquee-item-font-size: 40;</attribute>
        </xpath>
    </template>

    <!-- ======== PRODUCTS & ADVANTAGES ======== -->
    <template id="s_products_and_advantages" inherit_id="website.s_products_and_advantages">
        <!-- Grid container -->
        <xpath expr="//div[hasclass('o_grid_mode')]" position="attributes">
            <attribute name="style">gap: 8px;</attribute>
        </xpath>
        <!-- Card 1 -->
        <xpath expr="//div[hasclass('o_grid_item')][2]//div[hasclass('s_card')]" position="attributes">
            <attribute name="class" add="o_cc2" remove="o_cc1" separator=" "/>
        </xpath>
        <!-- Card 2 -->
        <xpath expr="//div[hasclass('o_grid_item')][3]//div[hasclass('s_card')]" position="attributes">
            <attribute name="class" add="o_cc2" remove="o_cc1" separator=" "/>
        </xpath>
        <!-- Card 3 -->
        <xpath expr="//div[hasclass('o_grid_item')][4]//div[hasclass('s_card')]" position="attributes">
            <attribute name="class" add="o_cc4" remove="o_cc3" separator=" "/>
        </xpath>
        <!-- Card 4 -->
        <xpath expr="//div[hasclass('o_grid_item')][5]//div[hasclass('s_card')]" position="attributes">
            <attribute name="class" add="o_cc4" remove="o_cc3" separator=" "/>
        </xpath>
    </template>

    <!-- ======== CALL TO ACTION COUNTDOWN ======== -->
    <template id="s_call_to_action" inherit_id="website.s_call_to_action">
        <xpath expr="//section" position="attributes">
            <attribute name="class" add="oe_img_bg o_bg_img_center o_bg_img_origin_border_box" separator=" "/>
            <attribute name="style">background-image: url('/web/image/website.landscape_xl_2')</attribute>
        </xpath>
        <xpath expr="//div[hasclass('container')]" position="before">
            <div class="o_we_bg_filter bg-black-50" contenteditable="false"></div>
        </xpath>
        <xpath expr="//div[hasclass('row')]" position="replace" mode="inner">
            <div class="o_colored_level pb16 col-lg-12 text-center">
                <h2>Black friday sales</h2>
            </div>
            <div class="o_colored_level col-lg-12">
                <section class="s_countdown pt0 pb24" data-display="dhms" data-end-action="nothing" data-layout="text" data-layout-background="none" data-progress-bar-style="none" data-progress-bar-weight="thin" data-text-color="o-color-1" data-layout-background-color="400" data-progress-bar-color="o-color-1" data-end-time="1816862400" data-snippet="s_countdown" data-name="Countdown" data-size="80" contenteditable="false">
                    <div class="container" contenteditable="true">
                        <div class="s_countdown_canvas_wrapper text-center justify-content-center d-none">
                            <div class="s_countdown_canvas_flex"><canvas class="w-100"></canvas></div>
                            <div class="s_countdown_canvas_flex"><canvas class="w-100"></canvas></div>
                            <div class="s_countdown_canvas_flex"><canvas class="w-100"></canvas></div>
                            <div class="s_countdown_canvas_flex"><canvas class="w-100"></canvas></div>
                            <div class="s_countdown_canvas_flex" contenteditable="false"><canvas class="w-100"></canvas></div>
                            <div class="s_countdown_canvas_flex" contenteditable="false"><canvas class="w-100"></canvas></div>
                            <div class="s_countdown_canvas_flex" contenteditable="false"><canvas class="w-100"></canvas></div>
                            <div class="s_countdown_canvas_flex" contenteditable="false"><canvas class="w-100"></canvas></div>
                        </div>
                        <div class="s_countdown_inline d-flex flex-column align-items-start o_countdown_default">
                            <div class="s_countdown_inline_wrapper align-self-center text-center">
                                <div class="o_template_big_numbers">
                                    <div class="o_not_editable oe_unremovable d-inline-flex gap-1" contenteditable="false">
                                        <span class="o_count_item d-flex gap-1">
                                            <span class="d-flex flex-column align-items-center">
                                                <span class="o_count_item_nbs o_colored_text fs-3 fw-bold">02</span>
                                                <span class="o_count_item_label small"><span class="o_first_letter">D</span><span class="o_other_letters">ays</span></span>
                                            </span>
                                        </span>
                                        <span class="o_count_separator fs-3 fw-bold">:</span>
                                        <span class="o_count_item d-flex gap-1">
                                            <span class="d-flex flex-column align-items-center">
                                                <span class="o_count_item_nbs o_colored_text fs-3 fw-bold">15</span>
                                                <span class="o_count_item_label small"><span class="o_first_letter">H</span><span class="o_other_letters">ours</span></span>
                                            </span>
                                        </span>
                                        <span class="o_count_separator fs-3 fw-bold">:</span>
                                        <span class="o_count_item d-flex gap-1">
                                            <span class="d-flex flex-column align-items-center">
                                                <span class="o_count_item_nbs o_colored_text fs-3 fw-bold">07</span>
                                                <span class="o_count_item_label small"><span class="o_first_letter">M</span><span class="o_other_letters">inutes</span></span>
                                            </span>
                                        </span>
                                        <span class="o_count_separator fs-3 fw-bold">:</span>
                                        <span class="o_count_item d-flex gap-1">
                                            <span class="d-flex flex-column align-items-center">
                                                <span class="o_count_item_nbs o_colored_text fs-3 fw-bold">38</span>
                                                <span class="o_count_item_label small"><span class="o_first_letter">S</span><span class="o_other_letters">econds</span></span>
                                            </span>
                                        </span>
                                    </div>
                                    <br/>
                                    <br/>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
                <p style="text-align: center;">
                    <a class="o_translate_inline btn btn-lg btn-secondary" href="/contactus">See All Offers</a>
                </p>
            </div>
        </xpath>
        <xpath expr="//a[hasclass('btn')]" position="attributes">
            <attribute name="class" add="btn-primary" remove="btn-secondary" separator=" "/>
        </xpath>
    </template>

    <!-- ======== STORE LOCATOR ======== -->
    <template id="s_hours_and_place" inherit_id="website.s_hours_and_place">
        <xpath expr="//section" position="attributes">
            <attribute name="class" add="o_cc2 pt32 pb104" remove="o_cc1 pt80 pb80" separator=" "/>
        </xpath>
        <!-- Move the heading inside the row -->
        <xpath expr="//div[hasclass('row')]/div[1]" position="before">
            <div class="o_colored_level col-lg-12">
                <h2 style="text-align: center;">Visit Us</h2>
                <p><br/></p>
            </div>
        </xpath>
        <xpath expr="//div[hasclass('container')]/h2" position="replace"/>
        <xpath expr="//div[hasclass('container')]/p" position="replace"/>
        <!-- Opening hours column -->
        <xpath expr="//div[hasclass('o_cc2')]" position="replace" mode="inner">
            <h3 class="h4-fs" style="text-align: center;">Store hours</h3>
            <p class="o_small-fs" style="text-align: center;"><u>Monday - Thursday</u><br/>9:00am - 7:00pm</p>
            <p class="o_small-fs" style="text-align: center;"><u>Friday</u><br/>9:00am - 8:00pm</p>
            <p class="o_small-fs" style="text-align: center;"><u>Saturday</u><br/>10:00am - 6:00pm</p>
            <p class="o_small-fs mb-0" style="text-align: center;"><u>Sunday</u><br/>Closed</p>
        </xpath>
        <!-- Replace the map by a store card, before the opening hours -->
        <xpath expr="//div[hasclass('o_cc2')]" position="before">
            <div class="col-lg-8 o_colored_level">
                <div class="s_card card o_cc o_cc1 m-0 h-100 o_colored_level flex-lg-row o_card_img_horizontal border" data-vxml="001" data-snippet="s_card" data-name="Card" style="--card-img-size-h: 50%; --box-border-left-width: 0px; --box-border-bottom-width: 0px; --box-border-right-width: 0px; --box-border-top-width: 0px;">
                    <figure class="o_card_img_wrapper mb-0 ratio ratio-1x1">
                        <img class="o_card_img o_editable_media card-img-top" src="/web/image/website.landscape_md_3" alt="" loading="lazy"/>
                    </figure>
                    <div class="card-body px-5 d-flex flex-column justify-content-center">
                        <h3 class="card-title h3-fs">Chicago</h3>
                        <p>1287 Maple Ave<br/>Chicago, IL 60606<br/>United States</p>
                        <p class="mb-0"><a class="o_translate_inline btn btn-primary" href="/contactus">Get directions</a></p>
                    </div>
                </div>
            </div>
        </xpath>
        <xpath expr="//div[hasclass('col-lg-9')]" position="replace"/>
        <xpath expr="//div[hasclass('o_cc2')]" position="attributes">
            <attribute name="class" add="o_cc4 col-lg-4 d-flex flex-column justify-content-center pt32 pb32" remove="o_cc2 col-lg-3 pt24 pb24" separator=" "/>
        </xpath>
    </template>

</odoo>
