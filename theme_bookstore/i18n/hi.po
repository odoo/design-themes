#. module: theme_bookstore
#: model_terms:theme.ir.ui.view,arch:theme_bookstore.s_call_to_action
msgid "Browse through <br/>our complete library"
msgstr "लाइब्रेरी में मौजूद सभी किताबों <br/>के कलेक्शन को ब्राउज़ करें"

#. module: theme_bookstore
#: model_terms:theme.ir.ui.view,arch:theme_bookstore.s_accordion
msgid "Can I request a book that's out of stock?"
msgstr "क्या जो किताब खत्म हो गई है, उसे मंगवाने के लिए कह सकते हैं?"

#. module: theme_bookstore
#: model_terms:theme.ir.ui.view,arch:theme_bookstore.s_cards_grid
msgid "Change the Way You Think"
msgstr "अपने सोचने के तरीके को बदलें"

#. module: theme_bookstore
#: model_terms:theme.ir.ui.view,arch:theme_bookstore.s_banner
msgid "Come Visit Us <i class=\"fa fa-angle-right\"/>"
msgstr "हमारे यहां आएं <i class=\"fa fa-angle-right\"/>"

#. module: theme_bookstore
#: model_terms:theme.ir.ui.view,arch:theme_bookstore.s_features_wall
msgid "Cozy Reading Nooks"
