<?xml version="1.0" encoding="utf-8"?>
<odoo>

<!-- ======== FOOTER ======== -->
<template id="template_footer_descriptive" inherit_id="website.template_footer_descriptive" name="Eclipse template_footer_descriptive">
    <!-- Shape -->
    <xpath expr="//section[hasclass('s_text_block')]" position="attributes">
        <attribute name="data-oe-shape-data"/>
    </xpath>
    <xpath expr="//div[hasclass('o_we_shape')]" position="replace"/>
</template>

<!-- ======== DISCOVERY ======== -->
<template id="s_discovery" inherit_id="website.s_discovery" name="Eclipse s_discovery">
    <!-- Section -->
    <xpath expr="//section" position="attributes">
        <attribute name="class" add="o_full_screen_height pt0 pb184" remove="pt136 pb136" separator=" "/>
        <attribute name="data-oe-shape-data">{"shape":"html_builder/Blurry/11","colors":{"c1":"o-color-1"}}</attribute>
    </xpath>
    <xpath expr="//section/div" position="before">
        <div class="o_we_shape o_html_builder_Blurry_11" style="background-image: url('/html_editor/shape/html_builder/Blurry/11.svg?c1=o-color-1');"/>
    </xpath>
    <!-- Badge -->
    <xpath expr="//span[hasclass('s_cta_badge')]" position="attributes">
        <attribute name="class" add="o_cc2" remove="o_cc1" separator=" "/>
    </xpath>
    <!-- Buttons -->
    <xpath expr="//a[hasclass('btn-primary')]" position="attributes">
        <attribute name="class" add="btn-lg" separator=" "/>
    </xpath>
    <xpath expr="//a[hasclass('btn-secondary')]" position="attributes">
        <attribute name="class" add="btn-lg" separator=" "/>
    </xpath>
</template>

<!-- ======== CLOSER LOOK ======== -->
<template id="s_closer_look" inherit_id="website.s_closer_look" name="Eclipse s_closer_look">
    <!-- Section -->
    <xpath expr="//section" position="attributes">
        <attribute name="data-oe-shape-data">{"shape":"html_builder/Blurry/03","colors":{"c1":"o-color-1","c2":"o-color-1","c3":"o-color-1","c4":"o-color-1"}}</attribute>
    </xpath>
    <xpath expr="//section/div" position="before">
        <div class="o_we_shape o_html_builder_Blurry_03" style="background-image: url('/html_editor/shape/html_builder/Blurry/03.svg?c1=o-color-1&amp;c2=o-color-1&amp;c3=o-color-1&amp;c4=o-color-1');"/>
    </xpath>
    <!-- Title -->
    <xpath expr="//h1" position="attributes">
        <attribute name="class" add="display-1" remove="display-3" separator=" "/>
    </xpath>
    <!-- Buttons -->
    <xpath expr="//a[hasclass('btn-primary')]" position="attributes">
        <attribute name="class" add="btn-lg" separator=" "/>
    </xpath>
    <xpath expr="//a[hasclass('btn-outline-primary')]" position="replace"/>
    <!-- Image -->
    <xpath expr="//img" position="attributes">
        <attribute name="class" add="img-thumbnail rounded shadow" separator=" "/>
        <attribute name="style">width: 80% !important; padding: 8px;</attribute>
        <attribute name="data-shape"/>
        <attribute name="src">/web/image/website.s_closer_look_default_image</attribute>
    </xpath>
</template>

<!-- ======== FEATURES ======== -->
<template id="s_features" inherit_id="website.s_features" name="Eclipse s_features">
    <!-- Cols -->
    <xpath expr="(//div[hasclass('s_hr')])" position="replace"/>
    <xpath expr="(//div[hasclass('s_hr')])" position="replace"/>
    <xpath expr="(//div[hasclass('s_hr')])" position="replace"/>
    <xpath expr="(//div[hasclass('col-lg-4')])[1]" position="attributes">
        <attribute name="class" add="pt32" separator=" "/>
    </xpath>
    <xpath expr="(//div[hasclass('col-lg-4')])[2]" position="attributes">
        <attribute name="class" add="pt32" separator=" "/>
    </xpath>
    <xpath expr="(//div[hasclass('col-lg-4')])[3]" position="attributes">
        <attribute name="class" add="pt32" separator=" "/>
    </xpath>
    <!-- Icons -->
    <xpath expr="//i[hasclass('s_features_icon')]" position="attributes">
        <attribute name="class" add="border" separator=" "/>
    </xpath>
    <xpath expr="(//i[hasclass('s_features_icon')])[2]" position="attributes">
        <attribute name="class" add="border" separator=" "/>
    </xpath>
    <xpath expr="(//i[hasclass('s_features_icon')])[3]" position="attributes">
        <attribute name="class" add="border" separator=" "/>
    </xpath>
    <!-- Second row -->
    <xpath expr="//div[hasclass('row')]" position="after">
        <div class="row">
            <div class="col-lg-4 pt32">
                <i class="s_features_icon oi mb-3 rounded bg-o-color-3 border" data-icon="lock" role="img"/>
                <div class="overflow-hidden">
                    <h3 class="h5-fs">Security</h3>
                    <p>Advanced encryption and proactive threat detection keep your data safe, ensuring privacy and compliance at every level.</p>
                </div>
            </div>
            <div class="col-lg-4 pt32">
                <i class="s_features_icon oi mb-3 rounded bg-o-color-3 border" data-icon="settings" role="img"/>
                <div class="overflow-hidden">
                    <h3 class="h5-fs">Automation</h3>
                    <p>Streamline repetitive tasks with intelligent workflows that save time, reduce errors, and let your team focus on what matters.</p>
                </div>
            </div>
            <div class="col-lg-4 pt32">
                <i class="s_features_icon oi mb-3 rounded bg-o-color-3 border" data-icon="bar_chart" role="img"/>
                <div class="overflow-hidden">
                    <h3 class="h5-fs">Analytics</h3>
                    <p>Real-time dashboards and detailed reports give you actionable insights to make smarter decisions and track progress effortlessly.</p>
                </div>
            </div>
        </div>
    </xpath>
</template>

<!-- ======== KEY IMAGES ======== -->
<template id="s_key_images" inherit_id="website.s_key_images" name="Eclipse s_key_images">
    <!-- Caption -->
    <xpath expr="//div[hasclass('col-6')]/p[3]" position="inside">
        <br/><br/>
    </xpath>
    <xpath expr="(//div[hasclass('col-6')]/p[3])[2]" position="inside">
        <br/><br/>
    </xpath>
    <xpath expr="(//div[hasclass('col-6')]/p[3])[3]" position="inside">
        <br/><br/>
    </xpath>
    <xpath expr="(//div[hasclass('col-6')]/p[3])[4]" position="inside">
        <br/><br/>
    </xpath>
    <!-- Columns -->
    <xpath expr="//div[hasclass('col-lg-3')]" position="attributes">
        <attribute name="class" add="col-lg-6" remove="col-lg-3" separator=" "/>
    </xpath>
    <xpath expr="//div[hasclass('col-lg-3')]" position="attributes">
        <attribute name="class" add="col-lg-6" remove="col-lg-3" separator=" "/>
    </xpath>
    <xpath expr="//div[hasclass('col-lg-3')]" position="attributes">
        <attribute name="class" add="col-lg-6" remove="col-lg-3" separator=" "/>
    </xpath>
    <xpath expr="//div[hasclass('col-lg-3')]" position="attributes">
        <attribute name="class" add="col-lg-6" remove="col-lg-3" separator=" "/>
    </xpath>
</template>

<!-- ======== ANNOUNCEMENT SCROLL ======== -->
<template id="s_announcement_scroll" inherit_id="website.s_announcement_scroll" name="Eclipse s_announcement_scroll">
    <!-- Section -->
    <xpath expr="//section" position="attributes">
        <attribute name="style">--marquee-animation-speed: 1s; --marquee-item-font-size: 320;</attribute>
        <attribute name="data-oe-shape-data">{"shape":"html_builder/Blurry/09","colors":{"c1":"o-color-1"}}</attribute>
    </xpath>
    <!-- Shape -->
    <xpath expr="//section/div" position="before">
        <div class="o_we_shape o_html_builder_Blurry_09" style="background-image: url('/html_editor/shape/html_builder/Blurry/09.svg?c1=o-color-1');"/>
    </xpath>
</template>

</odoo>
