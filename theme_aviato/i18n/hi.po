#: model_terms:theme.ir.ui.view,arch:theme_aviato.s_title
msgid "Top Destinations"
msgstr "सबसे ज़्यादा पसंदीदा जगहें"

#. module: theme_aviato
#: model_terms:theme.ir.ui.view,arch:theme_aviato.s_popup
