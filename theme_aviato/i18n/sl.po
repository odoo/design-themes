msgid ""
"<b>A travel agent helps you to plan your <br/> trip from start to finish.</b>\n"
"        <br/>"
msgstr ""
"<b>Potovalni agent vam pomaga načrtovati vaše <br/> potovanje od začetka do "
"konca.</b>\n"
"        <br/>"

