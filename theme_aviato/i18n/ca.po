#. module: theme_aviato
#: model:ir.module.module,summary:base.module_theme_aviato
msgid "Travel, Excursion, Plane, Tour, Agency "
msgstr ""

msgid ""
"\" A trusted partner for adventure. <br/>Professional, reliable, and always "
"delivering unique experiences. \""
msgstr ""
"«El teu aliat de confiança per a qualsevol aventura. <br/>Professional, "
"segur i sempre compromès perquè visquis experiències úniques»."

msgid ""
"\" Exceptional service and planning! <br/>They made every trip truly "
"memorable. \""
msgstr ""
"«Un servei i una planificació excepcionals!<br/>Van fer que cada viatge fos "
"inoblidable»."

msgid ""
"\" They crafted unforgettable journeys. Seamless and perfectly tailored "
"trips. \""
msgstr ""
"«Van crear viatges inoblidables. Una experiència fluïda i totalment a mida»."

msgid "24/7 Travel Support"
msgstr "Servei d'assistència en viatges 24/7"

msgid "Book now"
msgstr "Reservar ara"

msgid "Get started"
msgstr "Comenceu"

msgid "Our services"
msgstr "Els nostres serveis"
