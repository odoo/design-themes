#: model_terms:theme.ir.ui.view,arch:theme_avantgarde.s_sidegrid
msgid "✴ San Francisco"
msgstr "✴ San Francisco"

msgid "<b>Since 1992</b> creating around the world."
msgstr "<b>Od 1992 roku</b>  tworzymy na całym świecie."

msgid ""
"<br/>Crafting spaces where creativity meets functionality,<br/>one design at "
"a time.<br/><br/>"
msgstr ""
"<br/>Tworzymy przestrzenie, w których kreatywność spotyka się z "
"funkcjonalnością,<br/> jeden projekt po drugim.<br/><br/>"

msgid ""
"<br/>Present your architectural projects online with a user-friendly "
"platform that streamlines all the steps, from setup to project showcase, "
"making it easy to share your vision with clients.<br/>"
msgstr ""
"<br/>Prezentuj swoje projekty architektoniczne online za pomocą przyjaznej "
"dla użytkownika platformy, która usprawnia wszystkie etapy, od konfiguracji "
"po prezentację projektu, ułatwiając dzielenie się swoją wizją z klientami."
"<br/>"

msgid ""
"<br/>Step into the future with our cutting-edge solutions tailored to "
"enhance your architectural projects. From optimizing designs to driving "
"innovative outcomes, our tools provide the foundation for sustainable "
"success. Don’t let traditional methods limit your creative potential any "
"longer.<br/><br/>"
msgstr ""
"<br/>Wkrocz w przyszłość dzięki naszym najnowocześniejszym rozwiązaniom "
"dostosowanym do potrzeb Twoich projektów architektonicznych. Od "
"optymalizacji projektów po wprowadzanie innowacyjnych rozwiązań, nasze "
"narzędzia stanowią podstawę trwałego sukcesu. Nie pozwól, aby tradycyjne "
"metody ograniczały Twój potencjał twórczy.<br/><br/>"

msgid ""
"<font class=\"text-gradient\" style=\"background-image: linear-"
"gradient(0deg, var(--o-color-1) 0%, var(--o-color-4) 90%);\">\n"
"            50+\n"
"        </font>"
msgstr ""
