#. module: theme_avantgarde
#: model:ir.module.module,shortdesc:base.module_theme_avantgarde
msgid "Avantgarde Theme"
msgstr "ຮູບແບບ ອາວອງກາດ"

#. module: theme_avantgarde
#: model_terms:theme.ir.ui.view,arch:theme_avantgarde.s_sidegrid
msgid "Come visit us from Tuesday 9 AM to Saturday 6 PM"
msgstr "ມາຢ້ຽມຢາມພວກເຮົາໄດ້ຕັ້ງແຕ່ວັນອັງຄານ 9 ໂມງເຊົ້າ ຫາ ວັນເສົາ 6 ໂມງແລງ"

#. module: theme_avantgarde
#: model:ir.module.module,summary:base.module_theme_avantgarde
msgid ""
"Design, Fine Art, Artwork, Creative, Creativity, Galleries, Trends, Shows, "
"Magazines, Blogs"
msgstr ""
"ການອອກແບບ, ວິຈິດສິນ, ຜົນງານສິລະປະ, ດ້ານການສ້າງສັນ, ຄວາມຄິດສ້າງສັນ, ຫໍວາງສະແດງ, ທ່າອ່ຽງ, ການ"
"ສະແດງ, ວາລະສານ, ບລັອກ"

#. module: theme_avantgarde
#: model_terms:theme.ir.ui.view,arch:theme_avantgarde.s_features_wall
msgid ""
"Discover a variety of animals from around the world, beautifully captured in "
"these detailed, scientific paintings."
msgstr ""
"ຄົ້ນພົບສັດຫຼາກຫຼາຍຊະນິດຈາກທົ່ວທຸກມຸມໂລກ, ທີ່ຖືກຖ່າຍທອດອອກມາຢ່າງສວຍງາມໃນຮູບແຕ້ມວິທະຍາສາດອັນລະອຽດອ່ອ"
"ນເຫຼົ່ານີ້."

#. module: theme_avantgarde
#: model_terms:theme.ir.ui.view,arch:theme_avantgarde.s_timeline
msgid "Discover the journey that made us the most popular gallery in town."
msgstr ""
"ຄົ້ນພົບເສັ້ນທາງທີ່ເຮັດໃຫ້ພວກເຮົາກາຍເປັນຫໍວາງສະແດງທີ່ໄດ້ຮັບຄວາມນິຍົມທີ່ສຸດໃນເມືອງ."

#. module: theme_avantgarde
#: model:ir.model.fields,field_description:theme_avantgarde.field_theme_utils__display_name
msgid "Display Name"
msgstr "ຊື່ສະແດງ"

#. module: theme_avantgarde
#: model_terms:theme.ir.ui.view,arch:theme_avantgarde.s_features_wall
msgid "Diverse Wildlife"
msgstr "ສັດປ່າທີ່ຫຼາກຫຼາຍ"

#. module: theme_avantgarde
#: model:ir.module.module,description:base.module_theme_avantgarde
msgid ""
"Editorial side-grid layout under a hamburger nav, flowing into a dense "
"features wall, carousel showcase, and chronological timeline before a "
"quadrant block. Feature-heavy with editorial pacing rather than long-form "
"passages / suited for design studios, art and culture magazines, creative "
"agencies, and trend-driven blogs"
msgstr ""
"ໂຄງຮ່າງຕາໜ່າງດ້ານຂ້າງແບບບັນນາທິການ ພາຍໃຕ້ເມນູຮູບແຮມເບີເກີ, ຕໍ່ເນື່ອງໄປສູ່ກຳແພງລວບລວມຈຸດເດັ່ນ, ສ່ວນ"
"ສະແດງພາບເລື່ອນ, ແລະ ເສັ້ນເວລາຕາມລຳດັບເຫດການ ກ່ອນເຂົ້າສູ່ບລັອກສີ່ສ່ວນ. ເນັ້ນຈຸດເດັ່ນພ້ອມຈັງຫວະການອ່າ"
"ນແບບບົດຄວາມ ຫຼາຍກວ່າຂໍ້ຄວາມຍາວໆ / ເໝາະສຳລັບສະຕູດິໂອອອກແບບ, ວາລະສານສິລະປະ ແລະ ວັດທະນະທ"
"ຳ, ຕົວແທນສ້າງສັນຜົນງານ, ແລະ ບລັອກຕາມທ່າອ່ຽງຍຸກໃໝ່"

#. module: theme_avantgarde
#: model_terms:theme.ir.ui.view,arch:theme_avantgarde.s_timeline
msgid "First Culture Award ®"
msgstr "ລາງວັນວັດທະນະທຳຄັ້ງທຳອິດ ®"

#. module: theme_avantgarde
#: model_terms:theme.ir.ui.view,arch:theme_avantgarde.s_features_wall
msgid "For all the family"
msgstr "ສຳລັບທຸກຄົນໃນຄອບຄົວ"

#. module: theme_avantgarde
#: model_terms:theme.ir.ui.view,arch:theme_avantgarde.s_features_wall
msgid "From 12th September to 20th February"
msgstr "ແຕ່ວັນທີ 12 ກັນຍາ ຫາ 20 ກຸມພາ"

#. module: theme_avantgarde
#: model_terms:theme.ir.ui.view,arch:theme_avantgarde.s_quadrant
msgid "Get Directions"
msgstr "ຂໍເສັ້ນທາງ"

#. module: theme_avantgarde
#: model:ir.model.fields,field_description:theme_avantgarde.field_theme_utils__id
msgid "ID"
msgstr "ລະຫັດ"

#. module: theme_avantgarde
#: model_terms:theme.ir.ui.view,arch:theme_avantgarde.s_timeline
msgid "Our history"
msgstr "ປະຫວັດຄວາມເປັນມາຂອງພວກເຮົາ"

#. module: theme_avantgarde
#: model_terms:theme.ir.ui.view,arch:theme_avantgarde.s_timeline
msgid "Purchase of the building"
msgstr "ການຊື້ຕຶກອາຄານ"

#. module: theme_avantgarde
#: model_terms:theme.ir.ui.view,arch:theme_avantgarde.s_features_wall
msgid ""
"Step back in time with classic, hand-painted illustrations that showcase the "
"charm of old-world artistry."
msgstr ""
"ຍ້ອນເວລາໄປກັບຮູບແຕ້ມປະກອບຄລາສສິກດ້ວຍມື ທີ່ສະແດງໃຫ້ເຫັນເຖິງສະເໜ່ຂອງສິລະປະໃນຍຸກເກົ່າ."

#. module: theme_avantgarde
#: model_terms:theme.ir.ui.view,arch:theme_avantgarde.s_features_wall
msgid "The Boston Public Library Collection"
msgstr "ຊຸດຜົນງານສະສົມຂອງຫໍສະໝຸດປະຊາຊົນ ບອສຕັນ"

#. module: theme_avantgarde
#: model_terms:theme.ir.ui.view,arch:theme_avantgarde.s_features_wall
msgid ""
"The Boston Public Library's exhibit features lovely bird and flower "
"paintings, bringing together nature, art, and science."
msgstr ""
"ງານວາງສະແດງຂອງຫໍສະໝຸດປະຊາຊົນ ບອສຕັນ ປະກອບດ້ວຍຮູບແຕ້ມນົກ ແລະ ດອກໄມ້ທີ່ສວຍງາມ, ປະສານລວມທຳມ"
"ະຊາດ, ສິລະປະ, ແລະ ວິທະຍາສາດເຂົ້າກັນ."

#. module: theme_avantgarde
#: model:ir.model,name:theme_avantgarde.model_theme_utils
msgid "Theme Utils"
msgstr "ເຄື່ອງມືຮູບແບບ"

#. module: theme_avantgarde
#: model_terms:theme.ir.ui.view,arch:theme_avantgarde.s_features_wall
msgid ""
"This exhibition offers something for everyone, with fascinating artwork that "
"will captivate both kids and adults alike."
msgstr ""
"ງານວາງສະແດງນີ້ມີສິ່ງທີ່ເໝາະສຳລັບທຸກຄົນ, ດ້ວຍຜົນງານສິລະປະອັນໜ້າປະທັບໃຈທີ່ຈະດຶງດູດທັງເດັກນ້ອຍ ແລະ ຜູ້ໃຫ"
"ຍ່."

#. module: theme_avantgarde
#: model_terms:theme.ir.ui.view,arch:theme_avantgarde.s_features_wall
msgid "Vintage Style"
msgstr "ແບບຍ້ອນຍຸກ"

#. module: theme_avantgarde
#: model_terms:theme.ir.ui.view,arch:theme_avantgarde.s_timeline
msgid "We open the cafeteria!"
msgstr "ພວກເຮົາເປີດຮ້ານອາຫານຫວ່າງແລ້ວ!"

#. module: theme_avantgarde
#: model_terms:theme.ir.ui.view,arch:theme_avantgarde.s_sidegrid
msgid "✴ San Francisco"
msgstr "✴ ຊານ ຟຣານຊິສໂກ"
