#. module: theme_buzzy
#: model_terms:theme.ir.ui.view,arch:theme_buzzy.s_discovery
msgid "<span style=\"font-weight: normal;\">Discover our solutions</span>"
msgstr "<span style=\"font-weight: normal;\">ຄົ້ນພົບວິທີແກ້ໄຂຂອງພວກເຮົາ</span>"

#. module: theme_buzzy
#: model_terms:theme.ir.ui.view,arch:theme_buzzy.s_key_benefits
msgid ""
"<span style=\"font-weight: normal;\">Discover our</span><br/><span "
"style=\"font-weight: normal;\">main <span class=\"o_text_highlight "
"o_translate_inline o_text_highlight_bold_2 o_text_highlight_fill\" style=\"--"
"text-highlight-color: var(--o-color-3);\">three benefits</span></span>"
msgstr ""
"<span style=\"font-weight: normal;\">ຄົ້ນພົບ</span><br/><span style=\"font-"
"weight: normal;\">ຜົນປະໂຫຍດຫຼັກ <span class=\"o_text_highlight "
"o_translate_inline o_text_highlight_bold_2 o_text_highlight_fill\" style=\"--"
"text-highlight-color: var(--o-color-3);\">3 ຢ່າງຂອງພວກເຮົາ</span></span>"

#. module: theme_buzzy
#: model_terms:theme.ir.ui.view,arch:theme_buzzy.s_key_benefits
msgid ""
"Benefit from unique collaborations and partnerships that give your business "
"a competitive edge in the market."
msgstr ""
"ໄດ້ຮັບຜົນປະໂຫຍດຈາກການຮ່ວມມື ແລະ ຄູ່ຮ່ວມທຸລະກິດທີ່ໂດດເດັ່ນ ເຊິ່ງຊ່ວຍສ້າງທ່າແຮງໃນການແຂ່ງຂັນທາງການຕະຫຼ"
"າດໃຫ້ແກ່ທຸລະກິດຂອງທ່ານ."

