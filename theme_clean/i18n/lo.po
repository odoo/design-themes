#. module: theme_clean
#: model:ir.module.module,shortdesc:base.module_theme_clean
msgid "Clean Theme"
msgstr "ຮູບແບບ Clean"

#. module: theme_clean
#: model:ir.model.fields,field_description:theme_clean.field_theme_utils__display_name
msgid "Display Name"
msgstr "ຊື່ສະແດງ"

#. module: theme_clean
#: model_terms:theme.ir.ui.view,arch:theme_clean.s_text_image
msgid "Everything you need, <br/>totally free"
msgstr "ທຸກຢ່າງທີ່ທ່ານຕ້ອງການ, <br/>ຟຣີທັງໝົດ"

#. module: theme_clean
#: model:ir.model.fields,field_description:theme_clean.field_theme_utils__id
msgid "ID"
msgstr "ລະຫັດ"

#. module: theme_clean
#: model:ir.module.module,summary:base.module_theme_clean
msgid "Legal, Corporate, Business, Tech, Services"
msgstr "ກົດໝາຍ, ອົງກອນ, ທຸລະກິດ, ເຕັກໂນໂລຊີ, ການບໍລິການ"

#. module: theme_clean
#: model_terms:theme.ir.ui.view,arch:theme_clean.s_shape_image
msgid "Start Now <span class=\"oi ms-2\" data-icon=\"keyboard_arrow_right\"/>"
msgstr ""
"ເລີ່ມຕົ້ນດຽວນີ້ <span class=\"oi ms-2\" data-icon=\"keyboard_arrow_right\"/>"

#. module: theme_clean
#: model:ir.model,name:theme_clean.model_theme_utils
msgid "Theme Utils"
msgstr "ເຄື່ອງມືຮູບແບບ"

#. module: theme_clean
#: model_terms:theme.ir.ui.view,arch:theme_clean.s_shape_image
msgid ""
"This is a simple hero unit, a simple jumbotron-style component for calling "
"extra attention to featured content or information."
msgstr ""
"ນີ້ແມ່ນສ່ວນ hero ແບບຮຽບງ່າຍ, ເຊິ່ງເປັນອົງປະກອບຮູບແບບ jumbotron ເພື່ອດຶງດູດຄວາມສົນໃຈເປັນພິເສດຕໍ່ເ"
"ນື້ອຫາ ຫຼື ຂໍ້ມູນທີ່ໂດດເດັ່ນ."

#. module: theme_clean
#: model_terms:theme.ir.ui.view,arch:theme_clean.s_text_image
msgid ""
"Track every expenses, uncover new ways to save, choose the right credit "
"cards. <br/>All those advices and much more are included and totally free of "
"charge."
msgstr ""
"ຕິດຕາມທຸກລາຍຈ່າຍ, ຄົ້ນຫາວິທີການປະຢັດແບບໃໝ່, ເລືອກບັດເຄຣດິດທີ່ເໝາະສົມ. <br/>ຄຳແນະນຳທັງໝົດເຫຼົ່ານີ້ ແ"
"ລະ ອື່ນໆອີກຫຼາຍຢ່າງແມ່ນລວມຢູ່ທີ່ນີ້ ແລະ ບໍ່ມີຄ່າໃຊ້ຈ່າຍໃດໆທັງໝົດ."

#. module: theme_clean
#: model_terms:theme.ir.ui.view,arch:theme_clean.s_shape_image
msgid ""
"Unleash your <strong><span class=\"o_text_highlight o_translate_inline "
"o_text_highlight_freehand_1\" style=\"--text-highlight-width: 6px; --text-"
"highlight-color: var(--o-color-1);\">potential</span>.</strong>"
msgstr ""
"ປົດປ່ອຍ <strong><span class=\"o_text_highlight o_translate_inline "
"o_text_highlight_freehand_1\" style=\"--text-highlight-width: 6px; --text-"
"highlight-color: var(--o-color-1);\">ທ່າແຮງ</span> ຂອງທ່ານ.</strong>"

#. module: theme_clean
#: model:ir.module.module,description:base.module_theme_clean
msgid ""
"Vertically-rhythmic layout pairing a banner with a color-blocked section, "
"alternating text-and-image rows, a numbers showcase, basic team block, and "
"accordion FAQ with patterned and line image-shape crops (sketched oval ring, "
"dot pattern, labyrinth) carrying the visual signature across the hero and "
"content rows. Text-driven and information-dense with generous whitespace / "
"suited for legal practices, business consultancies, technology companies, "
"and professional services"
msgstr ""
"ໂຄງຮ່າງທີ່ມີຈັງຫວະຕາມລວງຕັ້ງ ໂດຍຈັບຄູ່ປ້າຍໂຄສະນາກັບພາກສ່ວນບລັອກສີ, ແຖວຂໍ້ຄວາມ ແລະ ຮູບພາບສະຫຼັບກັ"
"ນ, ການສະແດງຕົວເລກ, ບລັອກທີມງານພື້ນຖານ, ແລະ ພາກສ່ວນຖາມ-ຕອບ (FAQ) ແບບພັບເປີດ-ປິດໄດ້ ພ້ອມດ້ວ"
"ຍການຕັດຮູບຮ່າງຮູບພາບແບບມີລວດລາຍ ແລະ ເສັ້ນສາຍ (ວົງຮີແຕ້ມເສັ້ນ, ລວດລາຍຈຸດ, ເຂົາວົງກົດ) ທີ່ເນັ້ນຄວາມ"
"ເປັນເອກະລັກທາງສາຍຕາຕະຫຼອດທັງສ່ວນ hero ແລະ ແຖວເນື້ອຫາ. ເນັ້ນຂໍ້ຄວາມ ແລະ ຂໍ້ມູນທີ່ໜາແໜ້ນ ພ້ອມພື້ນທີ່ວ່"
"າງທີ່ເໝາະສົມ / ເໝາະສຳລັບຫ້ອງການກົດໝາຍ, ທີ່ປຶກສາທຸລະກິດ, ບໍລິສັດເຕັກໂນໂລຊີ, ແລະ ການບໍລິການແບບມືອາ"
"ຊີບ"

#. module: theme_clean
#: model_terms:theme.ir.ui.view,arch:theme_clean.s_color_blocks_2
msgid ""
"We are committed to helping you achieve success with unparalleled support "
"and expert guidance, every step of the way."
msgstr ""
"ພວກເຮົາມຸ່ງໝັ້ນທີ່ຈະຊ່ວຍໃຫ້ທ່ານປະສົບຜົນສຳເລັດ ດ້ວຍການສະໜັບສະໜູນທີ່ດີເລີດ ແລະ ການແນະນຳຈາກຜູ້ຊ່ຽວຊານ ໃ"
"ນທຸກໆບາດກ້າວ."

#. module: theme_clean
#: model_terms:theme.ir.ui.view,arch:theme_clean.s_title
msgid "We create the perfect <br/>tailored solution for you"
msgstr "ພວກເຮົາສ້າງວິທີແກ້ໄຂບັນຫາທີ່ດີເລີດ <br/>ເຊິ່ງຖືກອອກແບບມາສະເພາະສຳລັບທ່ານ"
